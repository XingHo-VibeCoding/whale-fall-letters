# ============================================================
# 鲸落书简 · 环境变量模板（可以进仓库，因为里面【没有值】）
# ============================================================
# 用法：
#   1. 复制一份，改名成 .env        → cp .env.example .env
#   2. 把下面的空值填成你自己的        
#   3. .env 会被 .gitignore 挡住，永远不会进仓库
#
# 线上（CloudBase 云函数）不用这个文件：
#   变量填在控制台「云函数 → books → 函数配置 → 环境变量」里，
#   填完不需要重新部署就生效（函数里是每次请求现读 process.env）。
#
# ⚠️ 这个文件里【永远不能】出现真实密钥，它是给所有人看的模板。

# ---------- 必填 ----------
# 数据 API 的 API Key（服务端权限）
# 在哪拿：CloudBase 控制台 → 数据库 → 数据 API → API Key
# 少了它，books 函数的所有接口都会返回「服务端未配置数据源凭证」
PG_API_KEY=

# ---------- 选填 ----------
# 数据 API 基地址。不填就用代码里的默认值（线上环境）
# 本地拿假数据源测试时才需要改它
PG_API_BASE=
